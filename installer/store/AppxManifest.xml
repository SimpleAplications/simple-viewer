<?xml version="1.0" encoding="utf-8"?>
<!-- The Microsoft Store package. release.ps1 fills in the version and packs it with the
     published app; Microsoft signs it after its review. Name and Publisher are the values
     Partner Center gives under Product identity. -->
<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
  IgnorableNamespaces="uap rescap">
  <Identity Name="ReiksApps.Reiksviewer" Publisher="CN=54F64895-82FA-479D-9B7B-BE225219235C"
            Version="{{version}}" ProcessorArchitecture="x64"/>
  <Properties>
    <DisplayName>Reiks Viewer</DisplayName>
    <PublisherDisplayName>Reiks Apps</PublisherDisplayName>
    <Logo>Assets\StoreLogo.png</Logo>
  </Properties>
  <Dependencies>
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.17763.0" MaxVersionTested="10.0.26100.0"/>
  </Dependencies>
  <Resources>
    <Resource Language="en-us"/>
    <Resource Language="es-es"/>
    <Resource Language="sv-se"/>
    <Resource Language="fr-fr"/>
    <Resource Language="de-de"/>
    <Resource Language="pt-pt"/>
    <Resource Language="it-it"/>
  </Resources>
  <Applications>
    <Application Id="ReiksViewer" Executable="ReiksViewer.exe" EntryPoint="Windows.FullTrustApplication">
      <uap:VisualElements DisplayName="Reiks Viewer" Description="A private picture and video viewer"
                          BackgroundColor="transparent"
                          Square150x150Logo="Assets\Square150x150Logo.png" Square44x44Logo="Assets\Square44x44Logo.png"/>
      <!-- Puts the app in "Open with" and in Settings' default apps; Windows leaves the choice to the user. -->
      <Extensions>
        <uap:Extension Category="windows.fileTypeAssociation">
          <uap:FileTypeAssociation Name="pictures">
            <uap:SupportedFileTypes>
              <uap:FileType>.jpg</uap:FileType>
              <uap:FileType>.jpeg</uap:FileType>
              <uap:FileType>.jpe</uap:FileType>
              <uap:FileType>.jfif</uap:FileType>
              <uap:FileType>.png</uap:FileType>
              <uap:FileType>.apng</uap:FileType>
              <uap:FileType>.bmp</uap:FileType>
              <uap:FileType>.gif</uap:FileType>
              <uap:FileType>.tif</uap:FileType>
              <uap:FileType>.tiff</uap:FileType>
              <uap:FileType>.webp</uap:FileType>
              <uap:FileType>.ico</uap:FileType>
              <uap:FileType>.heic</uap:FileType>
              <uap:FileType>.heif</uap:FileType>
              <uap:FileType>.avif</uap:FileType>
              <uap:FileType>.jxl</uap:FileType>
              <uap:FileType>.jp2</uap:FileType>
              <uap:FileType>.j2k</uap:FileType>
              <uap:FileType>.tga</uap:FileType>
              <uap:FileType>.qoi</uap:FileType>
              <uap:FileType>.svg</uap:FileType>
            </uap:SupportedFileTypes>
          </uap:FileTypeAssociation>
        </uap:Extension>
        <uap:Extension Category="windows.fileTypeAssociation">
          <uap:FileTypeAssociation Name="videos">
            <uap:SupportedFileTypes>
              <uap:FileType>.mp4</uap:FileType>
              <uap:FileType>.m4v</uap:FileType>
              <uap:FileType>.mov</uap:FileType>
              <uap:FileType>.wmv</uap:FileType>
              <uap:FileType>.avi</uap:FileType>
              <uap:FileType>.mkv</uap:FileType>
              <uap:FileType>.webm</uap:FileType>
              <uap:FileType>.mpg</uap:FileType>
              <uap:FileType>.mpeg</uap:FileType>
              <uap:FileType>.3gp</uap:FileType>
              <uap:FileType>.ts</uap:FileType>
              <uap:FileType>.mts</uap:FileType>
              <uap:FileType>.m2ts</uap:FileType>
              <uap:FileType>.flv</uap:FileType>
              <uap:FileType>.f4v</uap:FileType>
              <uap:FileType>.ogv</uap:FileType>
              <uap:FileType>.vob</uap:FileType>
              <uap:FileType>.asf</uap:FileType>
              <uap:FileType>.gifv</uap:FileType>
              <uap:FileType>.mxf</uap:FileType>
              <uap:FileType>.divx</uap:FileType>
            </uap:SupportedFileTypes>
          </uap:FileTypeAssociation>
        </uap:Extension>
      </Extensions>
    </Application>
  </Applications>
  <Capabilities>
    <rescap:Capability Name="runFullTrust"/>
  </Capabilities>
</Package>
