<Window x:Class="ReiksViewer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Reiks Viewer" Width="1100" Height="750" MinWidth="480" MinHeight="320"
        Background="{DynamicResource WindowBrush}" WindowStartupLocation="CenterScreen"
        AllowDrop="True" Drop="OnDrop" PreviewKeyDown="OnKeyDown" Loaded="OnLoaded">
    <!-- Our own title bar (so the file name can sit in the middle); Windows still handles
         dragging, snapping and double-click-to-maximize on it. -->
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="32" GlassFrameThickness="0" CornerRadius="0"
                      ResizeBorderThickness="6" UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="Background" Value="Transparent"/>
            <!-- BorderBrush is used as the hover colour -->
            <Setter Property="BorderBrush" Value="{DynamicResource HoverBrush}"/>
            <Setter Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="Width" Value="40"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" Background="{TemplateBinding Background}" CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Background" Value="{Binding BorderBrush, RelativeSource={RelativeSource TemplatedParent}}"/>
                            </Trigger>
                            <!-- Tag="Active" marks a button whose function is on or whose menu is open -->
                            <Trigger Property="Tag" Value="Active">
                                <Setter TargetName="b" Property="Background" Value="{DynamicResource ActiveBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid x:Name="Root">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid x:Name="TitleBar" Height="32" Background="{DynamicResource WindowBrush}">
            <TextBlock x:Name="TitleText" Text="Reiks Viewer" Foreground="{DynamicResource TextBrush}" FontSize="13"
                       HorizontalAlignment="Center" VerticalAlignment="Center"
                       Margin="150,0" TextTrimming="CharacterEllipsis"/>
            <TextBlock x:Name="ModeText" Foreground="{DynamicResource TextBrush}" FontSize="12" Margin="12,0"
                       HorizontalAlignment="Left" VerticalAlignment="Center"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                        WindowChrome.IsHitTestVisibleInChrome="True">
                <Button x:Name="MinimizeButton" Content="&#xE921;" FontSize="10" Width="46" Height="32" ToolTip="Minimize" Click="OnMinimizeClick"/>
                <Button x:Name="MaximizeButton" Content="&#xE922;" FontSize="10" Width="46" Height="32"
                        ToolTip="Maximize" Click="OnMaximizeClick"/>
                <Button x:Name="CloseButton" Content="&#xE8BB;" FontSize="10" Width="46" Height="32" ToolTip="Close"
                        BorderBrush="#C42B1C" Click="OnCloseClick"/>
            </StackPanel>
        </Grid>

        <Grid x:Name="Viewport" Grid.Row="1" Background="Transparent" ClipToBounds="True"
              MouseWheel="OnWheel" MouseLeftButtonDown="OnMouseDown"
              MouseLeftButtonUp="OnMouseUp" MouseMove="OnMouseMove">
            <!-- Stage carries zoom/pan; the image inside carries rotation -->
            <Grid x:Name="Stage" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Grid.RenderTransform>
                    <TransformGroup>
                        <ScaleTransform x:Name="Zoom"/>
                        <TranslateTransform x:Name="Pan"/>
                    </TransformGroup>
                </Grid.RenderTransform>
                <Image x:Name="Img" Stretch="Uniform" StretchDirection="DownOnly"
                       RenderOptions.BitmapScalingMode="HighQuality">
                    <Image.LayoutTransform>
                        <!-- Rotation first, then the flips, so flips are as seen on screen -->
                        <TransformGroup>
                            <RotateTransform x:Name="Rot"/>
                            <ScaleTransform x:Name="Flip"/>
                        </TransformGroup>
                    </Image.LayoutTransform>
                </Image>
            </Grid>
            <TextBlock x:Name="Hint" Foreground="{DynamicResource TextBrush}" FontSize="16" TextAlignment="Center"
                       TextWrapping="Wrap" MaxWidth="560"
                       HorizontalAlignment="Center" VerticalAlignment="Center"
                       Text="Drop a picture, GIF or video here, or press O to open one."/>
            <!-- Quick hide: covers the picture until the key is pressed again -->
            <Border x:Name="Cover" Background="{DynamicResource WindowBrush}" Visibility="Collapsed"/>
        </Grid>

        <Grid x:Name="Bar" Grid.Row="2" Background="{DynamicResource WindowBrush}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Orientation="Horizontal" Margin="4,2">
                <Button x:Name="OpenButton" Content="&#xE8E5;" ToolTip="Open (O)" Click="OnOpenClick"/>
                <Button x:Name="PrevButton" Content="&#xE76B;" ToolTip="Previous file (Left, C)" Click="OnPrevClick"/>
                <Button x:Name="NextButton" Content="&#xE76C;" ToolTip="Next file (Right, V)" Click="OnNextClick"/>
            </StackPanel>

            <DockPanel x:Name="VideoPanel" Grid.Column="1" Margin="8,0" Visibility="Collapsed" LastChildFill="True">
                <Button x:Name="PlayButton" DockPanel.Dock="Left" Content="&#xE769;" ToolTip="Play / pause (Space)" Click="OnPlayClick"/>
                <Button x:Name="StepBackButton" DockPanel.Dock="Left" Content="&#xE892;"
                        ToolTip="Play backward (Z)"
                        PreviewMouseLeftButtonDown="OnStepBackDown"/>
                <Button x:Name="StepForwardButton" DockPanel.Dock="Left" Content="&#xE893;"
                        ToolTip="Play forward (X)"
                        PreviewMouseLeftButtonDown="OnStepForwardDown"/>
                <Slider x:Name="VolumeSlider" DockPanel.Dock="Right" Width="80" Minimum="0" Maximum="1" Value="0.8"
                        VerticalAlignment="Center" Focusable="False" IsMoveToPointEnabled="True"
                        ValueChanged="OnVolumeChanged"/>
                <Button x:Name="MuteButton" DockPanel.Dock="Right" Content="&#xE767;" ToolTip="Mute (M)" Click="OnMuteClick"/>
                <TextBlock x:Name="TimeText" DockPanel.Dock="Right" Foreground="{DynamicResource TextBrush}" Margin="8,0"
                           VerticalAlignment="Center" TextAlignment="Right" Text="0:00 / 0:00"/>
                <Slider x:Name="Seek" VerticalAlignment="Center" Focusable="False" IsMoveToPointEnabled="True"
                        Minimum="0" Maximum="1" ValueChanged="OnSeekChanged"/>
            </DockPanel>

            <TextBlock x:Name="StatusText" Grid.Column="2" Foreground="{DynamicResource TextBrush}" Margin="12,0"
                       VerticalAlignment="Center" TextAlignment="Right"/>

            <StackPanel Grid.Column="3" Orientation="Horizontal" Margin="4,2">
                <Button x:Name="AdjustButton" Content="&#xE706;" ToolTip="Picture settings (A)" Click="OnAdjustClick"/>
                <Button x:Name="ViewButton" ToolTip="View (R rotates)" Click="OnViewClick">
                    <!-- A picture with a small gear in its corner. The picture is cut away
                         around the gear so the two don't run into each other. -->
                    <Grid Width="22" Height="20">
                        <TextBlock Text="&#xE8B9;" HorizontalAlignment="Left" VerticalAlignment="Top">
                            <TextBlock.Clip>
                                <CombinedGeometry GeometryCombineMode="Exclude">
                                    <CombinedGeometry.Geometry1>
                                        <RectangleGeometry Rect="0,0,16,16"/>
                                    </CombinedGeometry.Geometry1>
                                    <CombinedGeometry.Geometry2>
                                        <EllipseGeometry Center="16,14" RadiusX="7.5" RadiusY="7.5"/>
                                    </CombinedGeometry.Geometry2>
                                </CombinedGeometry>
                            </TextBlock.Clip>
                        </TextBlock>
                        <TextBlock Text="&#xE713;" FontSize="12" HorizontalAlignment="Right" VerticalAlignment="Bottom"/>
                    </Grid>
                </Button>
                <Button x:Name="OptionsButton" Content="&#xE713;" ToolTip="Options" Click="OnOptionsClick"/>
                <Button x:Name="FormatsButton" Content="&#xE946;" ToolTip="Formats and credits (F1)" Click="OnFormatsClick"/>
                <Button x:Name="FolderButton" Content="&#xE786;" ToolTip="Play the whole folder (S)" Click="OnSlideshowClick"/>
                <Button x:Name="FullscreenButton" Content="&#xE740;" ToolTip="Fullscreen (F11, double-click)" Click="OnFullscreenClick"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
